{
  "name": "joe-browser",
  "productName": "Joe Browser",
  "version": "2.4.0",
  "description": "Joe Browser - a local-first anti-detect browser workspace for Windows. Unlimited isolated profiles, a coherent fingerprint per profile, and per-profile proxies.",
  "author": {
    "name": "Joe Goldberg"
  },
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node scripts/test.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 5183",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "flag-icons": "^7.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.38.0",
    "ws": "^8.18.0"
  }
}
